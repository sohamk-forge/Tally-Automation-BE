

<ENVELOPE>

  <HEADER>

    <VERSION>1</VERSION>

    <TALLYREQUEST>
      Export
    </TALLYREQUEST>

    <TYPE>
      Collection
    </TYPE>

    <ID>
      AllParentGroupDetails
    </ID>

  </HEADER>

  <BODY>

    <DESC>

      <STATICVARIABLES>

        <SVCURRENTCOMPANY>
          Nutan Dairy
        </SVCURRENTCOMPANY>

        <SVEXPORTFORMAT>
          $$SysName:XML
        </SVEXPORTFORMAT>

      </STATICVARIABLES>

      <TDL>

        <TDLMESSAGE>

          <COLLECTION
            NAME="AllParentGroupDetails"
          >

            <TYPE>
              Ledger
            </TYPE>

            <CHILDOF>
              Sundry Creditors
            </CHILDOF>

            <FETCH>

              NAME,

              PARENT,

              ADDRESS,

              MAILINGNAME,

              STATENAME,

              STATE,

              LEDSTATENAME,

              COUNTRYNAME,

              LEDCOUNTRYNAME,

              PINCODE,

              PHONE,

              LEDGERPHONE,

              MOBILE,

              LEDGERMOBILE,

              FAX,

              EMAIL,

              LEDGEREMAIL,

              CONTACTPERSON,

              PARTYGSTIN,

              GSTREGISTRATIONTYPE,

              INCOMETAXNUMBER,

              OPENINGBALANCE,

              CLOSINGBALANCE

            </FETCH>

          </COLLECTION>

        </TDLMESSAGE>

      </TDL>

    </DESC>

  </BODY>

</ENVELOPE>

  