{
  "name": "tally-sync",
  "version": "1.0.0",
  "description": "Tally to Database Sync Application",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:dashboard": "node --test --test-force-exit ../tests/dashboard/dashboard.test.mjs",
    "test:gst": "node --test --test-force-exit --test-concurrency=1 ../tests/gst/gstr1Builder.test.mjs ../tests/gst/portalAndReturns.test.mjs ../tests/gst/gstr1Pipeline.e2e.test.mjs ../tests/gst/imsPipeline.e2e.test.mjs ../tests/gst/gstr3bPipeline.e2e.test.mjs ../tests/gst/wholeFlow.e2e.test.mjs",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:make": "knex migrate:make",
    "seed:run": "knex seed:run",
    "db:reset": "npm run migrate:rollback && npm run migrate:latest",
    "migrate:users-to-supertokens": "node scripts/migrate-users-to-supertokens.js",
    "deploy": "git pull && npm install && npm run migrate:latest && (pm2 reload tally-backend --update-env || pm2 start src/server.js --name tally-backend)"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "ajv": "^8.17.1",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.9.3",
    "fastest-levenshtein": "^1.0.16",
    "form-data": "^4.0.6",
    "ioredis": "^5.11.1",
    "knex": "^3.2.9",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pdf-to-img": "^6.2.0",
    "pg": "^8.20.0",
    "puppeteer": "^25.4.0",
    "supertokens-node": "^24.0.3",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "loadtest": "^8.2.1",
    "nodemon": "^3.1.0"
  }
}
