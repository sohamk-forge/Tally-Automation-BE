{
  "name": "tally-sync",
  "version": "1.0.0",
  "description": "Tally to Database Sync Application",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:make": "knex migrate:make",
    "seed:run": "knex seed:run",
    "db:reset": "npm run migrate:rollback && npm run migrate:latest"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "bullmq": "^5.76.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.3.0",
    "ioredis": "^5.10.1",
    "knex": "^3.2.9",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "loadtest": "^8.2.1",
    "nodemon": "^3.1.0"
  }
}
