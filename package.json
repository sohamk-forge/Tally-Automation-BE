{
  "name": "tally-sync",
  "version": "1.0.0",
  "description": "Tally to Database Sync Application",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:make": "knex migrate:make",
    "seed:run": "knex seed:run",
    "db:reset": "npm run migrate:rollback && npm run migrate:latest"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.3.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "loadtest": "^8.2.1",
    "nodemon": "^3.1.0"
  }
}
