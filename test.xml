// ==============================
// Vouchers XML
// Fetch:
// - Voucher Date
// - Voucher Type
// - Voucher Number
// - Party Ledger
// - Amount
// - Narration
// ==============================
export function getVouchersXML(
  companyName = ""
) {

  const today =
    getTodayDate();

  return `
<ENVELOPE>

 <HEADER>

  <VERSION>
   1
  </VERSION>

  <TALLYREQUEST>
   Export
  </TALLYREQUEST>

  <TYPE>
   Collection
  </TYPE>

  <ID>
   VoucherCollection
  </ID>

 </HEADER>

 <BODY>

  <DESC>

   <STATICVARIABLES>

    <SVCURRENTCOMPANY>
     ${companyName}
    </SVCURRENTCOMPANY>

    <SVEXPORTFORMAT>
     $$SysName:XML
    </SVEXPORTFORMAT>

    <SVFROMDATE>
     20000101
    </SVFROMDATE>

    <SVTODATE>
     ${today}
    </SVTODATE>

    <SVLIMIT>
     500
    </SVLIMIT>

   </STATICVARIABLES>

   <TDL>

    <TDLMESSAGE>

     <COLLECTION NAME="VoucherCollection">

      <TYPE>
       Voucher
      </TYPE>

      <FETCH>

       DATE,
       VOUCHERTYPENAME,
       VOUCHERNUMBER,
       PARTYLEDGERNAME,
       AMOUNT,
       NARRATION

      </FETCH>

     </COLLECTION>

    </TDLMESSAGE>

   </TDL>

  </DESC>

 </BODY>

</ENVELOPE>
`;

}